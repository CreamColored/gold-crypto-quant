# 复制为 .env 后填写：cp .env.example .env
# .env 不进版本库（已在 .gitignore）。本文件只放键名与安全的示例值，禁止写入任何真实凭据。
# 新增配置项时两边同步：代码里加了字段，这里也要加一行。

# ---- 运行环境 ----
APP_ENV=development
# 真实下单总开关，必须保持 false：系统只用交易所公开行情做影子模拟。
LIVE_TRADING=false

# ---- 数据库 ----
DATABASE_URL=mysql+pymysql://quant_app:change-me@127.0.0.1:3306/quant?charset=utf8mb4

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=gcq

# ---- 交易所与品种（逗号分隔，留空即全部启用）----
# 可选：GATE_LIVE_PUBLIC, BINANCE_LIVE_PUBLIC
ACTIVE_VENUES=GATE_LIVE_PUBLIC
# 可选：BTC_USDT, ETH_USDT, XAU_USDT
ACTIVE_SYMBOLS=BTC_USDT,ETH_USDT

# ---- Gate 测试网凭据（公开行情采集不需要）----
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=
GATE_TESTNET_BASE_URL=https://api-testnet.gateapi.io/api/v4

# ---- OANDA Practice ----
OANDA_ENABLED=false
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com

# ---- Web 监管后台 ----
# 本机访问用 127.0.0.1；服务器上需要经隧道或反代对外时再改为 0.0.0.0。
WEB_HOST=127.0.0.1
# WEB_PORT=8765
# WEB_COOKIE_SECURE=false

# ---- 通知（留空即不发送）----
STATUS_EMAIL_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
# 邮箱服务提供的授权码，不是邮箱登录密码。
SMTP_PASSWORD=
SMTP_FROM=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---- 风控与宏观静默（代码里有默认值，需要覆盖时再取消注释）----
# RISK_PER_TRADE=0.0025
# DAILY_LOSS_LIMIT=0.02
# MAX_DRAWDOWN_LIMIT=0.08
# LEVERAGE=125
# MACRO_BLACKOUT_BEFORE_MINUTES=15
# MACRO_BLACKOUT_AFTER_MINUTES=15

APP_ENV=development
LIVE_TRADING=false
DATABASE_URL=mysql+pymysql://quant:change-me@127.0.0.1:3306/quant?charset=utf8mb4

# Keep credentials out of source control.
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=
GATE_TESTNET_BASE_URL=https://api-testnet.gateapi.io/api/v4
# 当前阶段保持false，只运行Gate的BTC_USDT和ETH_USDT。
OANDA_ENABLED=false
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com

# 需要通过SMTP发送成交和异常事件时填写；留空则不发送，密码应使用邮箱服务提供的授权码。
STATUS_EMAIL_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
